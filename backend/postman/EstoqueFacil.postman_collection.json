      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get(\"suffix\")) { const s = Date.now().toString(36); pm.collectionVariables.set(\"suffix\", s); pm.collectionVariables.set(\"emailA\", \"a.\" + s + \"@teste.com\"); pm.collectionVariables.set(\"emailB\", \"b.\" + s + \"@teste.com\"); }"
        ]
      }
    }
  ],
