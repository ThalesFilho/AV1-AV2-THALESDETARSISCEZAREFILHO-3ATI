# Copie este arquivo para .env e preencha os valores. NUNCA versione o .env.
# Formato: postgresql://usuario:senha@host:5432/banco
# Supabase: use a string "Session pooler" (Connect no painel do projeto). Local: postgresql://postgres:senha@localhost:5432/estoque
DATABASE_URL="postgresql://postgres:senha@localhost:5432/estoque"
# Use "true" para bancos na nuvem (Supabase exige SSL)
DATABASE_SSL="false"
# Opcional: certificado da CA do provedor, para também validar o certificado do servidor.
# Cole o PEM (quebras de linha podem ser \n)
# DATABASE_SSL_CA=""
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres"
JWT_EXPIRES_IN="2h"
PORT=3000
NODE_ENV="development"
# Lista separada por vírgulas (em desenvolvimento http://localhost:5173 já é permitido)
CORS_ORIGIN="http://localhost:5173"
# Usados apenas pelo script seed:admin
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@exemplo.com"
ADMIN_PASSWORD="troque-esta-senha"
